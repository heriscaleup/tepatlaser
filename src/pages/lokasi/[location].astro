const locationDepth = {
  eyebrow: `Konteks proyek ${location.name}`,
  title: `Jarak dikelola lewat data, approval presisi, dan serah terima yang terencana.`,
  intro: `Kolaborasi lintas wilayah tidak harus menambah ketidakpastian. File CAD, foto ukuran, PIC lokasi, jadwal pengiriman, dan metode packing dikunci sebelum material dipotong di workshop.`,
  pillars: location.pillars,
  checklistTitle: `Checklist order proyek di ${location.name}.`,
  checklistIntro: 'Kelengkapan informasi di awal mempermudah kalkulasi biaya termurah dan menjamin hasil potong langsung pas di lokasi.',
  checklist: location.checklist
};
---

<BaseLayout 
  title={title} 
  description={description} 
  keywords={`laser cutting ${location.name}, jasa laser cutting terdekat ${location.name}, CNC router ${location.name}, cutting plat besi ${location.name}, pagar laser cutting ${location.name}`} 
  url={`/lokasi/${location.slug}/`} 
  jsonLd={[breadcrumb, generateFAQSchema(faqs)]}
>
  <Header slot="header" />
  
  <main class="overflow-hidden">
    <PageIntro 
      eyebrow={`Area layanan terdekat · ${location.name}`} 
      title={`Jasa Laser Cutting & Fabrikasi Presisi untuk Wilayah ${location.name}.`} 
      description={`Workshop berkapasitas tinggi di Tangerang Selatan melayani review dan produksi untuk ${location.focus}. Garansi presisi tinggi dan hasil potong siap pakai.`} 
      image={location.image} 
      imageAlt={location.imageAlt} 
      imageTag={`AREA LAYANAN ${location.name.toUpperCase()}`} 
    />

    <section class="location-intro">
      <div class="container-custom">
        <div>
          <span>Workshop Terdekat</span>
          <strong>Tangerang Selatan</strong>
          <p>{SITE_CONFIG.address}</p>
        </div>
        <div>
          <span>Metode Serah Terima</span>
          <strong>Pickup atau Kirim Armada</strong>
          <p>{location.handover}</p>
        </div>
        <div>
          <span>Catatan Proyek</span>
          <strong>Review Teknis Sebelum Potong</strong>
          <p>{location.note}</p>
        </div>
      </div>
    </section>

    <!-- Visual Machine Capability Grid -->
    <section class="section-padding">
      <div class="container-custom">
        <span class="eyebrow">Kapabilitas Mesin & Material</span>
        <h2 class="heading-md mt-3 mb-6">4 Lini Mesin Utama Siap Memproses Pesanan di {location.name}</h2>
        <div class="location-grid">
          {SERVICES.map((service, index) => (
            <a href={`/${service.slug}/`} class="group">
              <span class="number-tag">0{index + 1}</span>
              <h2>{service.name}</h2>
              <p>{service.description}</p>
              <strong>Lihat spesifikasi ↗</strong>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Process Section -->
    <section class="dark-section section-padding">
      <div class="container-custom location-process">
        <div>
          <span class="eyebrow">Alur Kerja Cepat & Transparan</span>
          <h2 class="heading-md mt-5">File & Keputusan Disepakati Lebih Dulu. Produksi Berjalan Akurat Tanpa Revisi Berulang.</h2>
        </div>
        <ol>
          <li>
            <span>01</span>
            <div>
              <h3>Kirim Brief & Ukuran</h3>
              <p>Kirim jenis material, ukuran bidang, jumlah, dan file vector atau foto sketsa melalui WhatsApp.</p>
            </div>
          </li>
          <li>
            <span>02</span>
            <div>
              <h3>Review Teknis & Nesting</h3>
              <p>Tim memeriksa geometri, toleransi potong, efisiensi lembaran, dan mengestimasi harga terbaik.</p>
            </div>
          </li>
          <li>
            <span>03</span>
            <div>
              <h3>Konfirmasi & SPK</h3>
              <p>Spesifikasi bahan, harga final, lead-time pengerjaan, dan metode serah terima disepakati.</p>
            </div>
          </li>
          <li>
            <span>04</span>
            <div>
              <h3>Produksi, QC & Kirim</h3>
              <p>Mesin beroperasi presisi, hasil diperiksa QC, dipacking rapi, lalu dikirim aman ke {location.name}.</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <EditorialDepth {...locationDepth} />

    <!-- FAQ Section -->
    <section class="section-padding">
      <div class="container-custom location-faq">
        <div>
          <span class="eyebrow">Pertanyaan Wilayah Layanan</span>
          <h2 class="heading-md mt-5">Hal yang Sering Ditanyakan Sebelum Order di {location.name}.</h2>
        </div>
        <div>
          {faqs.map((faq, index) => (
            <details open={index === 0}>
              <summary>
                {faq.question}
                <span>＋</span>
              </summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Dedicated Solution Hubs Linking -->
    <section class="border-t border-[var(--line)] py-12 bg-black/60">
      <div class="container-custom">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-8">
          <div>
            <span class="text-xs font-bold uppercase tracking-widest text-[var(--laser)] mb-2 block">Solusi Aplikasi Populer di {location.name}</span>
            <h3 class="heading-sm text-white">Pilihan Kustomisasi Sesuai Kebutuhan Bangunan Anda</h3>
          </div>
          <a href="/harga-laser-cutting-per-meter/" class="text-xs text-[var(--laser)] hover:underline mt-2 md:mt-0 font-semibold">Cek Estimasi Harga Per Meter ↗</a>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
          <a href="/pagar-laser-cutting/" class="p-4 border border-[var(--line)] bg-[var(--surface)] hover:border-[var(--laser)] transition-all rounded text-left group">
            <span class="text-[10px] text-gray-400 block mb-1">Eksterior & Gerbang</span>
            <strong class="text-sm text-white group-hover:text-[var(--laser)] transition-colors block">Pagar Laser Cutting</strong>
          </a>
          <a href="/railing-laser-cutting/" class="p-4 border border-[var(--line)] bg-[var(--surface)] hover:border-[var(--laser)] transition-all rounded text-left group">
            <span class="text-[10px] text-gray-400 block mb-1">Tangga & Balkon</span>
            <strong class="text-sm text-white group-hover:text-[var(--laser)] transition-colors block">Railing Laser Cutting</strong>
          </a>
          <a href="/huruf-timbul-stainless-akrilik/" class="p-4 border border-[var(--line)] bg-[var(--surface)] hover:border-[var(--laser)] transition-all rounded text-left group">
            <span class="text-[10px] text-gray-400 block mb-1">Signage Toko & Kantor</span>
            <strong class="text-sm text-white group-hover:text-[var(--laser)] transition-colors block">Huruf Timbul 3D</strong>
          </a>
          <a href="/fasad-acp-laser-cutting/" class="p-4 border border-[var(--line)] bg-[var(--surface)] hover:border-[var(--laser)] transition-all rounded text-left group">
            <span class="text-[10px] text-gray-400 block mb-1">Selubung Bangunan</span>
            <strong class="text-sm text-white group-hover:text-[var(--laser)] transition-colors block">Fasad ACP & Gedung</strong>
          </a>
          <a href="/ornamen-krawangan-grc-masjid/" class="p-4 border border-[var(--line)] bg-[var(--surface)] hover:border-[var(--laser)] transition-all rounded text-left group">
            <span class="text-[10px] text-gray-400 block mb-1">Ornamen Islami</span>
            <strong class="text-sm text-white group-hover:text-[var(--laser)] transition-colors block">Mihrab & Krawangan</strong>
          </a>
        </div>
      </div>
    </section>

    <!-- Other Regional Hubs Linking -->
    <section class="border-t border-[var(--line)] py-10 bg-[var(--surface)] text-center">
      <div class="container-custom">
        <span class="text-xs font-bold uppercase tracking-widest text-[var(--laser)] mb-4 block">Wilayah Layanan Terdekat Lainnya:</span>
        <div class="flex flex-wrap justify-center gap-2">
          {allLocations.map((loc: any) => (
            <a 
              href={`/lokasi/${loc.slug}/`} 
              class={`text-xs py-2 px-4 rounded-full border transition-all ${loc.slug === location.slug ? 'bg-[var(--laser)] text-black border-[var(--laser)] font-bold shadow-md' : 'bg-black/40 text-gray-300 border-[var(--line)] hover:border-[var(--laser)] hover:text-white'}`}
            >
              {loc.name}
            </a>
          ))}
        </div>
      </div>
    </section>

    <CTA 
      title={`Mulai konsultasi proyek Anda di ${location.name}.`} 
      description="Kirim ukuran, jenis material, jumlah, dan file desain bila sudah ada. Tim teknis kami merespons cepat dengan estimasi harga resmi." 
      primaryText="Kirim File via WhatsApp" 
      secondaryText="Lihat Portofolio Hasil Kerja" 
      secondaryLink="/portfolio/" 
    />
  </main>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .location-intro{border-block:1px solid var(--line);background:var(--surface);padding-block:2rem}.location-intro>div{display:grid;gap:1.5rem}.location-intro span{color:var(--laser);font-size:.75rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.location-intro strong{display:block;margin-top:.45rem;color:#fff;font-family:'Clash Display',sans-serif;font-size:1.15rem}.location-intro p{margin-top:.35rem;font-size:.88rem;line-height:1.65}
  .location-grid{display:grid;gap:1px;margin-top:2rem;border:1px solid var(--line);background:var(--line)}.location-grid>a{background:var(--surface);padding:1.4rem;transition:background .35s var(--ease-smooth),transform .35s var(--ease-smooth)}.location-grid>a:hover{background:rgba(54,114,172,.09);transform:translateY(-4px)}.location-grid h2{margin-top:2.5rem;font-size:1.55rem;color:#fff}.location-grid p{margin-top:.8rem;font-size:.9rem;line-height:1.7;color:var(--ink-muted)}.location-grid strong{display:block;margin-top:1.3rem;color:var(--laser-deep);font-size:.78rem}
  .location-process{display:grid;gap:3rem}.location-process ol{display:grid;margin:0;padding:0;border:1px solid var(--line);list-style:none}.location-process li{display:grid;grid-template-columns:2.25rem 1fr;gap:.75rem;padding:1.25rem}.location-process li+li{border-top:1px solid var(--line)}.location-process li>span{color:var(--laser);font-size:.75rem;font-weight:800}.location-process h3{font-size:1.2rem;color:#fff}.location-process p{margin-top:.4rem;font-size:.9rem;line-height:1.65;color:var(--ink-muted)}
  .location-faq{display:grid;gap:3rem}.location-faq details{border-top:1px solid var(--line);padding:1.2rem 0}.location-faq details:last-child{border-bottom:1px solid var(--line)}.location-faq summary{display:flex;justify-content:space-between;gap:1rem;cursor:pointer;list-style:none;color:var(--ink);font-weight:750}.location-faq summary::-webkit-details-marker{display:none}.location-faq summary span{color:var(--laser)}.location-faq details p{margin-top:.75rem;font-size:.92rem;line-height:1.75;color:var(--ink-muted)}
  @media(min-width:800px){.location-intro>div{grid-template-columns:repeat(3,minmax(0,1fr))}.location-intro>div>div+div{border-left:1px solid var(--line);padding-left:1.5rem}.location-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.location-process,.location-faq{grid-template-columns:.8fr 1.2fr}.location-process ol{grid-template-columns:repeat(2,minmax(0,1fr))}.location-process li:nth-child(2n){border-left:1px solid var(--line)}.location-process li:nth-child(2){border-top:0}.location-process li:nth-child(n+3){border-top:1px solid var(--line)}}
</style>
