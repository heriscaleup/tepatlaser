---
import BaseLayout from '../components/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTA from '../components/CTA.astro';
import PageIntro from '../components/PageIntro.astro';
import { SITE_CONFIG } from '../utils/constants.js';

const canonicalUrl = 'https://tepatlaser.com/jasa-laser-cutting-bsd/';
const waUrl = `https://wa.me/${SITE_CONFIG.whatsapp}?text=${encodeURIComponent('Halo Tepat Laser, saya ingin konsultasi jasa laser cutting untuk proyek di BSD Serpong.')}`;

const schemaLocalBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  'name': 'Tepat Laser — Jasa Laser Cutting BSD Serpong',
  'description': 'Pusat fabrikasi laser cutting fiber metal, fasad ACP, dan partisi arsitektural terdekat kawasan BSD City, Gading Serpong, dan Alam Sutera.',
  'url': canonicalUrl,
  'telephone': SITE_CONFIG.phone,
  'priceRange': 'Rp 50.000 - Rp 2.500.000'
};
---

<BaseLayout
  title="Jasa Laser Cutting BSD Serpong Terdekat — Fasad ACP, Pagar & Metal Presisi"
  description="Penyedia jasa laser cutting BSD City & Gading Serpong. Spesialis fasad gedung ACP, pagar plat besi, partisi arsitektur, dan signage toko dengan mesin fiber 12kW presisi ±0.02mm."
  keywords="jasa laser cutting bsd, laser cutting serpong, laser cutting gading serpong, fasad acp bsd, potong plat besi bsd"
  url={canonicalUrl}
  jsonLd={[schemaLocalBusiness]}
>
  <Header slot="header" />

  <main class="overflow-hidden">
    <PageIntro
      eyebrow="LAYANAN PRIORITAS BSD CITY & GADING SERPONG"
      title="Jasa Laser Cutting BSD: Kapasitas Batch Besar, Presisi Fasad & Pengiriman Cepat."
      description="Dukungan mesin Fiber Laser 12kW dan CNC Router tugas berat untuk memenuhi kebutuhan kontraktor, pengembang komersial, dan pemilik hunian di kawasan BSD City, Gading Serpong, dan sekitarnya."
      image="/gambar/facade gedung.jpg"
      imageAlt="Fasad gedung dan panel arsitektural laser cutting di BSD Serpong"
      imageTag="AREA BSD & SERPONG"
    />

    <section class="section-padding bg-[#080b10]">
      <div class="container-custom">
        <div class="grid gap-12 lg:grid-cols-12">
          <div class="lg:col-span-8 space-y-8 text-gray-300 leading-relaxed">
            <h2 class="text-2xl font-bold text-white">Standar Fabrikasi Presisi untuk Proyek Komersial & Residensial BSD</h2>
            <p>
              Perkembangan pesat kawasan <strong>BSD City, Nava Park, The Mozia, dan Gading Serpong</strong> menuntut kecepatan produksi dan presisi geometri tanpa deviasi. Dari selubung bangunan (*secondary skin*) ACP perforated hingga gerbang cluster mewah, Tepat Laser hadir memberikan solusi pemotongan presisi tinggi berstandar industri.
            </p>
            
            <div class="grid gap-6 sm:grid-cols-2 mt-6">
              <div class="p-6 bg-[#111622] border border-[#1e293b] rounded-lg">
                <h3 class="text-lg font-bold text-cyan-400 mb-2">🏢 Fasad ACP & Secondary Skin</h3>
                <p class="text-sm text-gray-400">Pemotongan panel ACP Seven & Marks PVDF dengan router bit presisi untuk ruko dan gedung komersial BSD.</p>
                <a href="/fasad-acp-laser-cutting/" class="inline-block mt-3 text-cyan-400 font-bold text-sm">Lihat Fasad ACP ↗</a>
              </div>
              <div class="p-6 bg-[#111622] border border-[#1e293b] rounded-lg">
                <h3 class="text-lg font-bold text-green-400 mb-2">🏡 Pagar & Railing Balkon Mewah</h3>
                <p class="text-sm text-gray-400">Plat besi tebal 2mm - 4mm dipotong dengan gas Nitrogen murni bebas kerak dross untuk hunian mewah BSD.</p>
                <a href="/pagar-laser-cutting/" class="inline-block mt-3 text-green-400 font-bold text-sm">Lihat Pagar Custom ↗</a>
              </div>
            </div>
          </div>

          <div class="lg:col-span-4">
            <div class="bg-gradient-to-b from-[#111827] to-[#0b111e] border border-cyan-400 p-6 rounded-lg shadow-xl text-center">
              <span class="text-xs font-bold text-cyan-400 uppercase tracking-widest">KONSULTASI PROJECT BSD</span>
              <h3 class="text-lg font-bold text-white mt-2">Dapatkan Penawaran Harga Hari Ini</h3>
              <p class="text-sm text-gray-300 mt-2">Kirim gambar kerja CAD/PDF proyek BSD Anda untuk kalkulasi estimasi instan.</p>
              <a href={waUrl} target="_blank" rel="noopener noreferrer" class="mt-5 block w-full bg-green-500 hover:bg-green-400 text-black font-extrabold py-3 rounded text-sm transition">
                Chat WhatsApp Tim Teknis ↗
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <CTA />
  </main>

  <Footer slot="footer" />
</BaseLayout>
