---
import BaseLayout from '../components/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTA from '../components/CTA.astro';
import PageIntro from '../components/PageIntro.astro';
import EditorialDepth from '../components/EditorialDepth.astro';
import { generateBreadcrumbSchema, generateFAQSchema } from '../utils/seo.js';

const title = "Daftar Harga & Biaya Laser Cutting Per Meter 2026 | Tepat Laser";
const description = "Panduan estimasi biaya jasa laser cutting plat besi, stainless steel, akrilik, MDF, dan ACP per meter di Jabodetabek. Hitung efisiensi nesting & konsultasi gratis.";
const keywords = "harga laser cutting per meter, biaya laser cutting plat besi, tarif jasa laser cutting stainless, ongkos potong fiber laser, estimasi harga laser cutting akrilik";

const faqs = [
  {
    question: "Bagaimana cara menghitung biaya laser cutting per meter?",
    answer: "Biaya laser cutting dihitung berdasarkan panjang total jalur potong (cutting length dalam meter), jenis material, dan ketebalannya. Untuk pemotongan panel berulang seperti fasad atau pagar, biaya sering dikonversi menjadi satuan per meter persegi (m²) agar lebih mudah diestimasikan."
  },
  {
    question: "Apakah harga sudah termasuk bahan material?",
    answer: "Tepat Laser melayani dua skema: Jasa Potong Saja (Anda membawa lembaran material sendiri ke workshop) atau Paket Lengkap (kami menyediakan material berkualitas bersertifikat seperti Plat KS, Stainless 304, Akrilik Marga Cipta, dan ACP Seven)."
  },
  {
    question: "Faktor apa saja yang membuat harga lebih murah atau lebih mahal?",
    answer: "Tingkat kerumitan motif (semakin padat lubang potong, semakin lama waktu mesin beroperasi), ketebalan material, jenis gas bantu (Nitrogen untuk tepi bersih stainless vs Oksigen), serta volume pesanan (pesanan batch banyak mendapatkan diskon kuantitas khusus)."
  },
  {
    question: "Berapa lama waktu yang dibutuhkan untuk mendapatkan estimasi penawaran resmi?",
    answer: "Kirimkan file vector (DXF, DWG, AI, CDR, PDF) atau ukuran opening beserta foto sketsa via WhatsApp ke 0821-2129-2937. Tim teknis kami akan melakukan simulasi nesting CAD dan memberikan estimasi harga resmi dalam 15-30 menit pada jam operasional."
  }
];

const breadcrumb = generateBreadcrumbSchema([
  { name: 'Beranda', url: '/' },
  { name: 'Layanan', url: '/services/' },
  { name: 'Estimasi Harga Per Meter', url: '/harga-laser-cutting-per-meter/' }
]);

const priceDepth = {
  eyebrow: "Faktor Penentu Harga Transparan",
  title: "Kalkulasi Biaya Berbasis Parameter Mesin Nyata Tanpa Mark-Up Tersembunyi.",
  intro: "Kami menghitung estimasi biaya berdasarkan waktu pemotongan mesin aktual, efisiensi nesting lembaran bahan, dan pemilihan gas potong yang tepat.",
  pillars: [
    {
      title: "Panjang Jalur Potong (Cutting Length)",
      description: "Mesin fiber laser menghitung total jarak tempuh kepala laser dalam meter. Semakin rapat motif geometris, semakin panjang jalur potongnya.",
      evidence: "CAD Vector Path · Meter Lari · Waktu Siklus"
    },
    {
      title: "Ketebalan & Jenis Material",
      description: "Memotong plat besi 6mm membutuhkan daya laser lebih tinggi dibanding plat 1.2mm, sehingga kecepatan potong per meter berbeda.",
      evidence: "Daya Laser kW · Feed Rate · Feed Gas (N2/O2)"
    },
    {
      title: "Optimalisasi Nesting",
      description: "Susunan part pada lembaran bahan 1200x2400mm dirapatkan menggunakan software nesting otomatis untuk meminimalkan sisa plat yang terbuang.",
      evidence: "Auto-Nesting · Zero Waste Target · Hemat Biaya"
    }
  ],
  checklistTitle: "Checklist Mendapatkan Penawaran Harga Paling Akurat",
  checklistIntro: "Siapkan data berikut agar tim teknis kami bisa langsung menyimulasikan nesting lembaran bahan Anda:",
  checklist: [
    "File desain vector skala 1:1 (format DXF, DWG, AI, CDR, atau sketsa PDF).",
    "Jenis material (Plat Besi SPHC, Stainless Steel 201/304, Akrilik, MDF, atau ACP).",
    "Ketebalan bahan dalam millimeter (contoh: Plat Besi 2.0mm).",
    "Kuantitas unit yang ingin diproduksi.",
    "Status material: Bawa bahan sendiri atau disediakan oleh workshop Tepat Laser."
  ]
};
---

<BaseLayout 
  title={title} 
  description={description} 
  keywords={keywords} 
  url="/harga-laser-cutting-per-meter/" 
  jsonLd={[breadcrumb, generateFAQSchema(faqs)]}
>
  <Header slot="header" />
  
  <main class="overflow-hidden">
    <PageIntro 
      eyebrow="Transparansi Biaya & Estimasi" 
      title="Estimasi Harga & Biaya Laser Cutting Per Meter." 
      description="Kalkulasi biaya jasa potong berdasarkan ketebalan bahan, panjang jalur CAD, dan efisiensi nesting lembaran. Konsultasi dan review file gratis bersama tim teknis." 
      image="/images/v10/fiber-metal-workshop-real.webp" 
      imageAlt="Simulasi estimasi harga laser cutting presisi Tepat Laser" 
      imageTag="ESTIMASI BIAYA 2026" 
    />

    <!-- Price Table Section -->
    <section class="section-padding">
      <div class="container-custom">
        <span class="eyebrow">Daftar Patokan Harga Dasar</span>
        <h2 class="heading-md mt-3 mb-6">Tabel Estimasi Jasa Potong Berdasarkan Material & Ketebalan</h2>
        <p class="text-[var(--ink-muted)] text-sm max-w-3xl mb-10">
          Harga di bawah merupakan estimasi jasa pemotongan standar (cutting only). Harga final dipengaruhi oleh kepadatan motif dan total volume pesanan.
        </p>

        <div class="grid md:grid-cols-2 gap-8">
          <!-- Table 1: Metal Fiber Laser -->
          <div class="border border-[var(--line)] bg-[var(--surface)] p-6 rounded-xl">
            <div class="border-b border-[var(--line)] pb-4 mb-6">
              <span class="text-[var(--laser)] text-xs font-bold uppercase tracking-wider">01 · Metal Cutting</span>
              <h3 class="text-xl font-bold text-white mt-1">Laser Fiber Metal (Plat Besi & Stainless)</h3>
              <p class="text-xs text-[var(--ink-muted)] mt-1">Hasil potong presisi tinggi, tepi halus bebas deburring.</p>
            </div>
            
            <div class="overflow-x-auto">
              <table class="w-full text-sm text-left">
                <thead>
                  <tr class="text-xs uppercase text-[var(--laser)] border-b border-[var(--line)]">
                    <th class="py-2.5 px-2">Material</th>
                    <th class="py-2.5 px-2">Ketebalan</th>
                    <th class="py-2.5 px-2 text-right">Estimasi Jasa / Meter</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-[var(--line)] text-gray-300">
                  <tr>
                    <td class="py-3 px-2 font-medium text-white">Plat Besi (SPHC)</td>
                    <td class="py-3 px-2 text-[var(--ink-muted)]">1.0 mm - 1.5 mm</td>
                    <td class="py-3 px-2 text-right font-bold text-[var(--laser)]">Rp 12.000 - Rp 18.000</td>
                  </tr>
                  <tr>
                    <td class="py-3 px-2 font-medium text-white">Plat Besi (SPHC)</td>
                    <td class="py-3 px-2 text-[var(--ink-muted)]">2.0 mm - 3.0 mm</td>
                    <td class="py-3 px-2 text-right font-bold text-[var(--laser)]">Rp 22.000 - Rp 35.000</td>
                  </tr>
                  <tr>
                    <td class="py-3 px-2 font-medium text-white">Plat Besi Tebal</td>
                    <td class="py-3 px-2 text-[var(--ink-muted)]">4.0 mm - 6.0 mm</td>
                    <td class="py-3 px-2 text-right font-bold text-[var(--laser)]">Rp 45.000 - Rp 70.000</td>
                  </tr>
                  <tr>
                    <td class="py-3 px-2 font-medium text-white">Stainless Steel (201/304)</td>
                    <td class="py-3 px-2 text-[var(--ink-muted)]">0.8 mm - 1.5 mm</td>
                    <td class="py-3 px-2 text-right font-bold text-[var(--laser)]">Rp 20.000 - Rp 32.000</td>
                  </tr>
                  <tr>
                    <td class="py-3 px-2 font-medium text-white">Stainless Steel (201/304)</td>
                    <td class="py-3 px-2 text-[var(--ink-muted)]">2.0 mm - 3.0 mm</td>
                    <td class="py-3 px-2 text-right font-bold text-[var(--laser)]">Rp 40.000 - Rp 65.000</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Table 2: Non-Metal & CNC Router -->
          <div class="border border-[var(--line)] bg-[var(--surface)] p-6 rounded-xl">
            <div class="border-b border-[var(--line)] pb-4 mb-6">
              <span class="text-[var(--laser)] text-xs font-bold uppercase tracking-wider">02 · Non-Metal & CNC Router</span>
              <h3 class="text-xl font-bold text-white mt-1">Akrilik, Kayu MDF & Panel Fasad ACP</h3>
              <p class="text-xs text-[var(--ink-muted)] mt-1">Signage huruf timbul, display ritel, dan secondary skin gedung.</p>
            </div>
            
            <div class="overflow-x-auto">
              <table class="w-full text-sm text-left">
                <thead>
                  <tr class="text-xs uppercase text-[var(--laser)] border-b border-[var(--line)]">
                    <th class="py-2.5 px-2">Material</th>
                    <th class="py-2.5 px-2">Ketebalan</th>
                    <th class="py-2.5 px-2 text-right">Estimasi Jasa / Satuan</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-[var(--line)] text-gray-300">
                  <tr>
                    <td class="py-3 px-2 font-medium text-white">Akrilik Bening/Warna</td>
                    <td class="py-3 px-2 text-[var(--ink-muted)]">2.0 mm - 3.0 mm</td>
                    <td class="py-3 px-2 text-right font-bold text-[var(--laser)]">Rp 8.000 - Rp 15.000 / m</td>
                  </tr>
                  <tr>
                    <td class="py-3 px-2 font-medium text-white">Akrilik Tebal Display</td>
                    <td class="py-3 px-2 text-[var(--ink-muted)]">5.0 mm - 10.0 mm</td>
                    <td class="py-3 px-2 text-right font-bold text-[var(--laser)]">Rp 20.000 - Rp 45.000 / m</td>
                  </tr>
                  <tr>
                    <td class="py-3 px-2 font-medium text-white">MDF / Plywood</td>
                    <td class="py-3 px-2 text-[var(--ink-muted)]">3.0 mm - 9.0 mm</td>
                    <td class="py-3 px-2 text-right font-bold text-[var(--laser)]">Rp 10.000 - Rp 25.000 / m</td>
                  </tr>
                  <tr>
                    <td class="py-3 px-2 font-medium text-white">ACP (Aluminium Composite)</td>
                    <td class="py-3 px-2 text-[var(--ink-muted)]">3.0 mm - 4.0 mm</td>
                    <td class="py-3 px-2 text-right font-bold text-[var(--laser)]">Rp 25.000 - Rp 50.000 / m²</td>
                  </tr>
                  <tr>
                    <td class="py-3 px-2 font-medium text-white">GRC Board (Fasad/Mihrab)</td>
                    <td class="py-3 px-2 text-[var(--ink-muted)]">8.0 mm - 15.0 mm</td>
                    <td class="py-3 px-2 text-right font-bold text-[var(--laser)]">Rp 45.000 - Rp 90.000 / m²</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Visual Material Cards Section -->
    <section class="section-padding bg-black/40 border-y border-[var(--line)]">
      <div class="container-custom">
        <span class="eyebrow">Stok Material Ready Workshop</span>
        <h2 class="heading-md mt-3 mb-8">Pilihan Material Bersertifikasi Siap Potong</h2>
        
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
          <div class="border border-[var(--line)] rounded-xl overflow-hidden bg-[var(--surface)] group">
            <div class="h-28 overflow-hidden">
              <img src="/images/metal.webp" alt="Plat Besi SPHC Laser Cutting" loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition-transform" />
            </div>
            <div class="p-3 text-center">
              <h4 class="font-bold text-white text-xs">Plat Besi</h4>
              <p class="text-[11px] text-[var(--ink-muted)] mt-0.5">0.5 - 12 mm</p>
            </div>
          </div>

          <div class="border border-[var(--line)] rounded-xl overflow-hidden bg-[var(--surface)] group">
            <div class="h-28 overflow-hidden">
              <img src="/images/stainlesssteel (3).webp" alt="Stainless Steel 201 304 Laser Cutting" loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition-transform" />
            </div>
            <div class="p-3 text-center">
              <h4 class="font-bold text-white text-xs">Stainless Steel</h4>
              <p class="text-[11px] text-[var(--ink-muted)] mt-0.5">0.5 - 6 mm</p>
            </div>
          </div>

          <div class="border border-[var(--line)] rounded-xl overflow-hidden bg-[var(--surface)] group">
            <div class="h-28 overflow-hidden">
              <img src="/images/Acrylic.webp" alt="Akrilik Bening dan Warna Laser Cutting" loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition-transform" />
            </div>
            <div class="p-3 text-center">
              <h4 class="font-bold text-white text-xs">Akrilik</h4>
              <p class="text-[11px] text-[var(--ink-muted)] mt-0.5">1.5 - 20 mm</p>
            </div>
          </div>

          <div class="border border-[var(--line)] rounded-xl overflow-hidden bg-[var(--surface)] group">
            <div class="h-28 overflow-hidden">
              <img src="/images/acp.webp" alt="ACP Aluminium Composite Panel CNC Router" loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition-transform" />
            </div>
            <div class="p-3 text-center">
              <h4 class="font-bold text-white text-xs">ACP Panel</h4>
              <p class="text-[11px] text-[var(--ink-muted)] mt-0.5">3.0 - 4.0 mm</p>
            </div>
          </div>

          <div class="border border-[var(--line)] rounded-xl overflow-hidden bg-[var(--surface)] group">
            <div class="h-28 overflow-hidden">
              <img src="/images/mdf.webp" alt="MDF HMR Hijau CNC Router Kayu" loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition-transform" />
            </div>
            <div class="p-3 text-center">
              <h4 class="font-bold text-white text-xs">MDF & HMR</h4>
              <p class="text-[11px] text-[var(--ink-muted)] mt-0.5">3.0 - 18 mm</p>
            </div>
          </div>

          <div class="border border-[var(--line)] rounded-xl overflow-hidden bg-[var(--surface)] group">
            <div class="h-28 overflow-hidden">
              <img src="/images/grc.webp" alt="GRC Board Mihrab Ornamen Dinding" loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition-transform" />
            </div>
            <div class="p-3 text-center">
              <h4 class="font-bold text-white text-xs">GRC Board</h4>
              <p class="text-[11px] text-[var(--ink-muted)] mt-0.5">8.0 - 15 mm</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <EditorialDepth {...priceDepth} />

    <!-- FAQ Section -->
    <section class="section-padding">
      <div class="container-custom location-faq">
        <div>
          <span class="eyebrow">Pertanyaan Seputar Biaya</span>
          <h2 class="heading-md mt-5">Semua Hal Mengenai Ongkos Potong, Nesting, dan Skema Pembayaran.</h2>
        </div>
        <div>
          {faqs.map((faq, index) => (
            <details open={index === 0}>
              <summary>
                {faq.question}
                <span>＋</span>
              </summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <CTA 
      title="Dapatkan estimasi harga akurat untuk proyek Anda sekarang." 
      description="Kirimkan file gambar kerja atau sketsa dimensi Anda melalui WhatsApp. Tim kami siap merespons dengan hitungan nesting terbaik." 
      primaryText="Hitung Biaya via WhatsApp" 
      secondaryText="Konsultasi Alur Produksi" 
      secondaryLink="/proses-produksi-lead-time/" 
    />
  </main>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .location-faq{display:grid;gap:3rem}.location-faq details{border-top:1px solid var(--line);padding:1.2rem 0}.location-faq details:last-child{border-bottom:1px solid var(--line)}.location-faq summary{display:flex;justify-content:space-between;gap:1rem;cursor:pointer;list-style:none;color:var(--ink);font-weight:750}.location-faq summary::-webkit-details-marker{display:none}.location-faq summary span{color:var(--laser)}.location-faq details p{margin-top:.75rem;font-size:.92rem;line-height:1.75;color:var(--ink-muted)}
  @media(min-width:800px){.location-faq{grid-template-columns:.8fr 1.2fr}}
</style>
